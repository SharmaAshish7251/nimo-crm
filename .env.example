# MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nimo-crm?retryWrites=true&w=majority

# JWT Session Encryption Key (must be a secure key of at least 32 characters/bytes)
SESSION_SECRET=replace_with_a_secure_random_string_of_at_least_32_chars

# Nodemailer SMTP Configuration (Add actual values to .env.local — NEVER commit real credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_app_password
SMTP_FROM="NIMO-CRM <your_smtp_username>"

# Firebase Cloud Messaging Service Account (HTTP V1 API for mobile push notifications)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Paste the entire JSON as a single-line string:
FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"nimo-crm",...}'

# Google OAuth 2.0 (for 1-Click Sign-in & Gmail Auto-Email Dispatch)
# Create at: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Add redirect URI: http://localhost:3000/api/auth/google/callback (dev)
#                   https://your-vercel-url.vercel.app/api/auth/google/callback (prod)
# Enable: Gmail API in Google Cloud Console -> APIs & Services -> Library
GOOGLE_CLIENT_ID=your-google-client-id-from-cloud-console
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public App URL (used for OAuth callback redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
